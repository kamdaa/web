---
import { Image } from 'astro:assets';
import type { Artwork } from '../lib/art';
import { url } from '../lib/url';

interface Props {
  artworks: Artwork[];
}

const { artworks } = Astro.props;
const clones = 3;
const slides = [...artworks, ...artworks.slice(0, clones)];
---

<div
  class="recent-carousel relative"
  data-carousel
  data-count={artworks.length}
  style="--index: 0;"
>
  <div class="overflow-hidden">
    <div class="carousel-track" data-track>
      {
        slides.map((artwork, index) => {
          const isClone = index >= artworks.length;
          const isSvg = artwork.image.format === 'svg';

          return (
            <a
              href={url(`/work/${artwork.collection}`)}
              class="carousel-card group"
              aria-hidden={isClone ? 'true' : undefined}
              tabindex={isClone ? -1 : undefined}
              aria-label={`${artwork.title}${artwork.year ? `, ${artwork.year}` : ''} — ${artwork.collectionName}`}
            >
              <span class="artframe block aspect-square">
                {isSvg ? (
                  <img
                    src={artwork.image.src}
                    width={artwork.image.width}
                    height={artwork.image.height}
                    alt={artwork.alt}
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-[1.2s] ease-soft group-hover:scale-[1.03]"
                  />
                ) : (
                  <Image
                    src={artwork.image}
                    alt={artwork.alt}
                    widths={[420, 640, 900]}
                    sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 90vw"
                    format="webp"
                    quality={88}
                    loading={index < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                    class="h-full w-full object-cover transition-transform duration-[1.2s] ease-soft group-hover:scale-[1.03]"
                  />
                )}
              </span>

              <span class="mt-3 flex items-baseline justify-between gap-4 border-t border-line/80 pt-2.5">
                <span class="font-serif text-[1rem] leading-snug tracking-[-0.01em]">{artwork.title}</span>
                <span class="shrink-0 text-[0.62rem] uppercase tracking-[0.14em] text-ink-faint">
                  {artwork.year ?? artwork.collectionName}
                </span>
              </span>
            </a>
          );
        })
      }
    </div>
  </div>

  <div class="mt-6 flex items-center justify-between border-t border-line pt-4">
    <p class="text-[0.62rem] font-medium uppercase tracking-[0.2em] text-ink-faint">
      {artworks.length} works
    </p>
    <button
      type="button"
      class="text-[0.62rem] font-medium uppercase tracking-[0.2em] text-ink-soft transition-colors hover:text-ink"
      data-toggle
      aria-pressed="false"
    >
      Pause
    </button>
  </div>
</div>

<style>
  .recent-carousel {
    --gap: 1.5rem;
    --visible: 1;
  }

  @media (min-width: 640px) {
    .recent-carousel {
      --visible: 2;
    }
  }

  @media (min-width: 1024px) {
    .recent-carousel {
      --visible: 3;
    }
  }

  .carousel-track {
    display: flex;
    gap: var(--gap);
    transform: translateX(calc(-1 * var(--index, 0) * (100% + var(--gap)) / var(--visible)));
    transition: transform 0.75s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }

  .carousel-card {
    flex: 0 0 calc((100% - (var(--visible) - 1) * var(--gap)) / var(--visible));
    min-width: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track {
      transition: none;
    }
  }
</style>

<script>
  const timers: number[] = [];
  const timeouts: number[] = [];

  function initCarousel() {
    timers.forEach((timer) => window.clearInterval(timer));
    timeouts.forEach((timer) => window.clearTimeout(timer));
    timers.length = 0;
    timeouts.length = 0;

    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
      const track = root.querySelector<HTMLElement>('[data-track]');
      const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
      if (!track) return;

      const total = Number(root.dataset.count ?? 0);
      if (!total) return;

      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = 0;
      let paused = reduced;
      let hovering = false;
      let resetting = false;

      if (reduced && toggle) {
        toggle.hidden = true;
      }

      const setIndex = (value: number) => {
        index = value;
        root.style.setProperty('--index', String(value));
      };

      const reset = () => {
        track.style.transition = 'none';
        setIndex(0);
        void track.offsetWidth;
        track.style.transition = '';
        resetting = false;
      };

      const advance = () => {
        if (paused || hovering || resetting || document.hidden) return;

        setIndex(index + 1);

        if (index === total) {
          resetting = true;
          timeouts.push(window.setTimeout(reset, 850));
        }
      };

      toggle?.addEventListener('click', () => {
        paused = !paused;
        toggle.textContent = paused ? 'Play' : 'Pause';
        toggle.setAttribute('aria-pressed', String(paused));
      });

      root.addEventListener('mouseenter', () => {
        hovering = true;
      });
      root.addEventListener('mouseleave', () => {
        hovering = false;
      });
      root.addEventListener('focusin', () => {
        hovering = true;
      });
      root.addEventListener('focusout', (event) => {
        if (!root.contains(event.relatedTarget as Node)) hovering = false;
      });

      if (!reduced) {
        timers.push(window.setInterval(advance, 3000));
      }
    });
  }

  initCarousel();
  document.addEventListener('astro:page-load', initCarousel);
</script>
