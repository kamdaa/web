---
/**
 * Sparse pastel decorations for the homepage hero.
 * Inline SVGs, kept away from the text and light enough not to compete with it.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- Cropped coral sun, top right -->
  <svg
    class="absolute -right-24 -top-24 hidden w-[340px] sm:block md:-right-10 md:-top-28 md:w-[520px]"
    viewBox="0 0 560 560"
    fill="none"
  >
    <circle cx="280" cy="280" r="250" fill="#ef7f74"></circle>
    <circle cx="280" cy="280" r="196" fill="#fbf2e0"></circle>
    <circle cx="280" cy="280" r="138" fill="#ef7f74"></circle>
    <circle cx="280" cy="280" r="78" fill="#fbf2e0"></circle>
    <circle cx="280" cy="280" r="250" stroke="#2f2a25" stroke-width="2.4"></circle>
    <circle cx="280" cy="280" r="196" stroke="#2f2a25" stroke-width="1.6" opacity="0.6"></circle>
  </svg>

  <!-- Small mustard ring, echoing the artwork -->
  <svg
    class="absolute right-[30%] top-[14%] hidden w-12 md:block lg:right-[32%] lg:w-14"
    viewBox="0 0 80 80"
    fill="none"
  >
    <circle cx="40" cy="40" r="29" stroke="#e6b44b" stroke-width="11"></circle>
  </svg>

  <!-- Peach dashes near the sun -->
  <svg
    class="absolute right-[24%] top-[38%] hidden w-10 md:block"
    viewBox="0 0 120 120"
    fill="none"
  >
    <rect x="16" y="18" width="22" height="9" rx="4.5" fill="#f2b28c" transform="rotate(-35 16 18)"></rect>
    <rect x="58" y="8" width="26" height="9" rx="4.5" fill="#f2b28c" transform="rotate(-10 58 8)"></rect>
    <rect x="82" y="44" width="20" height="9" rx="4.5" fill="#f2b28c" transform="rotate(24 82 44)"></rect>
  </svg>

  <!-- Botanical stem, bottom left -->
  <svg
    class="absolute -left-10 -bottom-2 hidden w-[190px] opacity-75 sm:block sm:w-[240px] md:-left-2 md:w-[300px]"
    viewBox="0 0 300 520"
    fill="none"
  >
    <path d="M150 520C160 400 128 300 158 150" stroke="#2f2a25" stroke-width="3" stroke-linecap="round"></path>
    <g transform="translate(152 402) rotate(34)">
      <path d="M0 0C34-64 104-70 150 0C104 70 34 64 0 0Z" fill="#93a77c" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L150 0" stroke="#2f2a25" stroke-width="1.2" opacity="0.5"></path>
    </g>
    <g transform="translate(146 300) rotate(-38)">
      <path d="M0 0C30-56 92-62 132 0C92 62 30 56 0 0Z" fill="#fbf2e0" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L132 0" stroke="#2f2a25" stroke-width="1.2" opacity="0.5"></path>
    </g>
    <g transform="translate(150 206) rotate(30)">
      <path d="M0 0C24-46 76-52 108 0C76 52 24 46 0 0Z" fill="#c3cfa9" stroke="#2f2a25" stroke-width="2.2"></path>
    </g>
  </svg>

  <!-- Teal wave, drawn as a hairline across the bottom of the hero -->
  <svg class="absolute bottom-0 left-0 w-full" height="18" viewBox="0 0 1440 18" preserveAspectRatio="none" fill="none">
    <path
      d="M0 9C120 1 240 17 360 9C480 1 600 17 720 9C840 1 960 17 1080 9C1200 1 1320 17 1440 9"
      stroke="#6f9f98"
      stroke-width="2"
      opacity="0.55"></path>
  </svg>
</div>
