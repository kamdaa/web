---
/**
 * Sparse pastel decorations for the homepage hero.
 * Inline SVGs, kept away from the text and light enough not to compete with it.
 */
---

<div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <!-- Solid orange sun, top right -->
  <svg
    class="absolute -right-16 -top-16 hidden w-[280px] sm:block md:-right-6 md:-top-24 md:w-[330px]"
    viewBox="0 0 430 430"
    fill="none"
  >
    <circle cx="215" cy="215" r="195" fill="#e98a63"></circle>
  </svg>

  <!-- Small filled mustard dot below the sun -->
  <svg
    class="absolute right-[14%] top-[38%] hidden w-[180px] sm:block"
    viewBox="0 0 40 40"
    fill="none"
  >
    <circle cx="20" cy="20" r="20" fill="#e6b44b"></circle>
  </svg>

  <!-- Single wavy creeper, light green, bottom left -->
  <svg
    class="absolute -left-16 -bottom-2 hidden w-[190px] sm:block sm:w-[240px] md:-left-20 md:w-[280px]"
    viewBox="0 0 280 520"
    fill="none"
  >
    <path
      d="M145 520C160 470 130 432 146 384C162 336 132 300 146 254C160 208 136 172 146 124C152 96 154 78 156 62"
      stroke="#2f2a25"
      stroke-width="3.4"
      stroke-linecap="round"></path>
    <path
      d="M156 62C166 46 184 48 182 64C180 76 166 76 164 66"
      stroke="#2f2a25"
      stroke-width="2.4"
      stroke-linecap="round"></path>

    <g transform="translate(148 468) rotate(38)">
      <path d="M0 0C13-23 40-27 56 0C40 27 13 23 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L56 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(140 418) rotate(-40)">
      <path d="M0 0C12-21 37-25 52 0C37 25 12 21 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L52 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(150 366) rotate(34)">
      <path d="M0 0C14-24 42-28 58 0C42 28 14 24 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L58 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(138 312) rotate(-36)">
      <path d="M0 0C12-21 37-25 52 0C37 25 12 21 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L52 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(150 260) rotate(32)">
      <path d="M0 0C12-22 38-26 54 0C38 26 12 22 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L54 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(138 208) rotate(-34)">
      <path d="M0 0C11-20 35-24 50 0C35 24 11 20 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L50 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(150 156) rotate(30)">
      <path d="M0 0C11-20 35-24 50 0C35 24 11 20 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L50 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
    <g transform="translate(142 106) rotate(-30)">
      <path d="M0 0C10-18 31-22 45 0C31 22 10 18 0 0Z" fill="#b8cc97" stroke="#2f2a25" stroke-width="2.2"></path>
      <path d="M0 0L45 0" stroke="#2f2a25" stroke-width="1.1" opacity="0.5"></path>
    </g>
  </svg>

  <!-- Teal wave hairline across the bottom of the hero -->
  <svg class="absolute bottom-0 left-0 w-full" height="18" viewBox="0 0 1440 18" preserveAspectRatio="none" fill="none">
    <path
      d="M0 9C120 1 240 17 360 9C480 1 600 17 720 9C840 1 960 17 1080 9C1200 1 1320 17 1440 9"
      stroke="#6f9f98"
      stroke-width="2"
      opacity="0.55"></path>
  </svg>
</div>
