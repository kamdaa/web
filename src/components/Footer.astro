---
import { nav, site } from '../config';
import { url } from '../lib/url';

interface Props {
  year: number;
}
const { year } = Astro.props;
---

<footer class="mt-24 border-t border-line">
  <div class="container-page py-12 md:py-16">
    <div class="flex flex-col gap-12 md:flex-row md:justify-between">
      <div>
        <a href={url('/')} class="font-serif text-xl tracking-[-0.02em]">{site.name}</a>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-ink-soft">{site.tagline}</p>
        <a class="arrow-link mt-6" href={`mailto:${site.email}`}>
          <span>{site.email}</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="grid grid-cols-2 gap-10 text-sm md:gap-16">
        <div>
          <p class="eyebrow">Pages</p>
          <ul class="mt-4 space-y-2.5 text-ink-soft">
            {
              nav.map((item) => (
                <li>
                  <a class="link-underline transition-colors hover:text-ink" href={url(item.href)}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div>
          <p class="eyebrow">Elsewhere</p>
          <ul class="mt-4 space-y-2.5 text-ink-soft">
            <li>
              <a
                class="link-underline transition-colors hover:text-ink"
                href={site.instagram.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                Instagram
              </a>
            </li>
            <li>
              <a class="link-underline transition-colors hover:text-ink" href={`mailto:${site.email}`}>
                Email
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>

    <div
      class="mt-12 flex flex-col gap-2 border-t border-line pt-6 text-[0.7rem] tracking-[0.03em] text-ink-faint sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {year} {site.name}. All images and words are the artist's own.</p>
      <p class="sm:text-right">Made slowly.</p>
    </div>
  </div>
</footer>
