---
import { getImage } from 'astro:assets';
import ArtCard from './ArtCard.astro';
import type { Artwork } from '../lib/art';

interface Props {
  artworks: Artwork[];
  showCollection?: boolean;
}

const { artworks, showCollection = false } = Astro.props;

const items = await Promise.all(
  artworks.map(async (artwork) => {
    let fullSrc = artwork.image.src;
    if (artwork.image.format !== 'svg') {
      const optimized = await getImage({
        src: artwork.image,
        width: 2000,
        format: 'webp',
        quality: 92,
      });
      fullSrc = optimized.src;
    }

    return {
      src: fullSrc,
      title: artwork.title,
      year: artwork.year,
      collection: artwork.collectionName,
      alt: artwork.alt,
      width: artwork.image.width,
      height: artwork.image.height,
    };
  }),
);
---

<div data-gallery data-artworks={JSON.stringify(items)}>
  <div class="masonry-grid" data-masonry>
    {
      artworks.map((artwork, index) => (
        <ArtCard
          artwork={artwork}
          index={index}
          priority={index < 3}
          showCollection={showCollection}
        />
      ))
    }
  </div>

  <dialog class="lightbox" aria-label="Artwork viewer" tabindex="-1">
  <div class="lightbox-shell">
    <div class="lightbox-bar">
      <span class="lightbox-count" data-counter aria-live="polite"></span>
      <button type="button" class="lb-control lb-close" data-close aria-label="Close viewer">
        <span>Close</span>
        <svg width="11" height="11" viewBox="0 0 11 11" fill="none" aria-hidden="true">
          <path d="M1 1L10 10M10 1L1 10" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </button>
    </div>

    <div class="lightbox-stage" data-stage>
      <button type="button" class="lb-control lb-nav lb-prev" data-prev aria-label="Previous artwork">
        <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
          <path d="M10.5 2L4 8.5L10.5 15" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </button>

      <img class="lightbox-img" data-img alt="" decoding="async" draggable="false" />

      <button type="button" class="lb-control lb-nav lb-next" data-next aria-label="Next artwork">
        <svg width="17" height="17" viewBox="0 0 17 17" fill="none" aria-hidden="true">
          <path d="M6.5 2L13 8.5L6.5 15" stroke="currentColor" stroke-width="1.2"></path>
        </svg>
      </button>
    </div>

    <div class="lightbox-caption">
      <div>
        <h3 class="lightbox-title" data-title></h3>
        <p class="lightbox-meta" data-meta aria-live="polite"></p>
      </div>
      <p class="lightbox-hint">Use ← → to browse · Esc to close</p>
    </div>
  </div>
  </dialog>
</div>

<style>
  .masonry-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: start;
    gap: 1.75rem;
  }

  @media (min-width: 640px) {
    .masonry-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .masonry-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .masonry-grid.is-masonry {
    grid-auto-rows: 4px;
    row-gap: 0;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-paper);
    overflow: hidden;
  }

  .lightbox[open] {
    display: flex;
  }

  .lightbox:focus {
    outline: none;
  }

  .lightbox::backdrop {
    background: rgb(32 28 23 / 0.88);
    backdrop-filter: blur(16px) saturate(0.75);
  }

  .lightbox-shell {
    display: flex;
    width: 100%;
    height: 100%;
    flex-direction: column;
    animation: lb-fade 0.35s var(--ease-soft) both;
  }

  .lightbox-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.35rem;
  }

  .lightbox-count {
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(247 243 236 / 0.6);
    font-variant-numeric: tabular-nums;
  }

  .lb-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgb(247 243 236 / 0.22);
    color: var(--color-paper);
    background: transparent;
    transition:
      background-color 0.3s var(--ease-soft),
      border-color 0.3s var(--ease-soft);
  }

  .lb-control:hover {
    background-color: rgb(247 243 236 / 0.1);
    border-color: rgb(247 243 236 / 0.5);
  }

  .lb-control:focus-visible {
    outline: 2px solid var(--color-clay);
    outline-offset: 3px;
  }

  .lb-close {
    gap: 0.7rem;
    padding: 0.6rem 0.95rem;
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .lightbox-stage {
    position: relative;
    display: flex;
    min-height: 0;
    flex: 1;
    align-items: center;
    justify-content: center;
    padding: 0 1rem;
    touch-action: pan-y;
  }

  .lightbox-img {
    max-width: min(92vw, 1500px);
    max-height: calc(100dvh - 13rem);
    width: auto;
    height: auto;
    object-fit: contain;
    box-shadow: 0 40px 90px -30px rgb(0 0 0 / 0.85);
    opacity: 0;
    transform: scale(0.985);
    transition:
      opacity 0.5s var(--ease-soft),
      transform 0.7s var(--ease-out-expo);
    user-select: none;
  }

  .lightbox-img.is-loaded {
    opacity: 1;
    transform: none;
  }

  .lb-nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    transform: translateY(-50%);
  }

  .lb-prev {
    left: max(0.4rem, 1.4vw);
  }

  .lb-next {
    right: max(0.4rem, 1.4vw);
  }

  .lightbox-caption {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding: 1.1rem 1.5rem 1.6rem;
  }

  .lightbox-title {
    font-size: 1.4rem;
    line-height: 1.2;
    letter-spacing: -0.015em;
    color: var(--color-paper);
  }

  .lightbox-meta {
    margin-top: 0.35rem;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgb(247 243 236 / 0.55);
  }

  .lightbox-hint {
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(247 243 236 / 0.38);
  }

  @media (max-width: 640px) {
    .lb-nav {
      width: 2.5rem;
      height: 2.5rem;
    }

    .lightbox-img {
      max-height: calc(100dvh - 14rem);
    }

    .lightbox-caption {
      padding-bottom: 1.25rem;
    }

    .lightbox-hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox-shell,
    .lightbox-img {
      animation: none;
      transition: none;
    }

    .lightbox-img {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes lb-fade {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  type LightboxItem = {
    src: string;
    title: string;
    year: number | null;
    collection: string;
    alt: string;
    width: number;
    height: number;
  };

  function layoutMasonry(gallery: HTMLElement) {
    const cards = Array.from(gallery.querySelectorAll<HTMLElement>('[data-artwork-card]'));
    if (cards.length === 0) return;

    gallery.classList.add('is-masonry');

    for (const card of cards) {
      card.style.gridRowEnd = 'auto';
    }

    const styles = getComputedStyle(gallery);
    const rowHeight = Number.parseFloat(styles.getPropertyValue('grid-auto-rows')) || 4;
    const gap = Number.parseFloat(styles.columnGap) || 28;

    const measured = cards.map((card) => ({
      card,
      height: card.getBoundingClientRect().height,
    }));

    for (const { card, height } of measured) {
      const span = Math.max(1, Math.ceil((height + gap) / rowHeight));
      card.style.gridRowEnd = `span ${span}`;
    }
  }

  let resizeObservers: ResizeObserver[] = [];

  function setupGallery(gallery: HTMLElement) {
    const dialog = gallery.querySelector<HTMLDialogElement>('.lightbox');
    if (!dialog || dialog.dataset.bound === 'true') return;
    dialog.dataset.bound = 'true';

    const grid = gallery.querySelector<HTMLElement>('[data-masonry]');
    if (grid) {
      layoutMasonry(grid);

      let frame = 0;
      const scheduleLayout = () => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          frame = 0;
          layoutMasonry(grid);
        });
      };

      const cardObserver = new ResizeObserver(scheduleLayout);
      grid.querySelectorAll<HTMLElement>('[data-artwork-card]').forEach((card) => {
        cardObserver.observe(card);
      });
      resizeObservers.push(cardObserver);

      let lastWidth = grid.clientWidth;
      const widthObserver = new ResizeObserver(() => {
        if (grid.clientWidth === lastWidth) return;
        lastWidth = grid.clientWidth;
        scheduleLayout();
      });
      widthObserver.observe(grid);
      resizeObservers.push(widthObserver);

      document.fonts?.ready.then(scheduleLayout);
    }

    let items: LightboxItem[] = [];
    try {
      items = JSON.parse(gallery.dataset.artworks ?? '[]') as LightboxItem[];
    } catch {
      items = [];
    }
    if (items.length === 0) return;

    const image = dialog.querySelector<HTMLImageElement>('[data-img]');
    const title = dialog.querySelector<HTMLElement>('[data-title]');
    const meta = dialog.querySelector<HTMLElement>('[data-meta]');
    const counter = dialog.querySelector<HTMLElement>('[data-counter]');
    const stage = dialog.querySelector<HTMLElement>('[data-stage]');

    let current = 0;
    let lastTrigger: HTMLElement | null = null;
    let pointerStart: { x: number; y: number } | null = null;

    const preload = (index: number) => {
      const item = items[(index + items.length) % items.length];
      if (!item) return;
      const neighbour = new Image();
      neighbour.src = item.src;
    };

    const render = () => {
      const item = items[current];
      if (!image || !item) return;

      image.classList.remove('is-loaded');
      image.alt = item.alt;
      image.src = item.src;

      if (image.complete) {
        requestAnimationFrame(() => image.classList.add('is-loaded'));
      } else {
        image.addEventListener('load', () => image.classList.add('is-loaded'), { once: true });
      }

      if (title) title.textContent = item.title;
      if (meta) {
        meta.textContent = [item.year, item.collection].filter(Boolean).join(' · ');
      }
      if (counter) {
        counter.textContent = `${String(current + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
      }

      preload(current + 1);
      preload(current - 1);
    };

    const go = (direction: number) => {
      current = (current + direction + items.length) % items.length;
      render();
    };

    const open = (index: number, trigger: HTMLElement | null) => {
      current = index;
      lastTrigger = trigger;
      render();
      dialog.showModal();
      dialog.focus({ preventScroll: true });
      document.documentElement.style.overflow = 'hidden';
    };

    const close = () => dialog.close();

    gallery.addEventListener('click', (event) => {
      const trigger = (event.target as HTMLElement).closest<HTMLElement>('[data-artwork-index]');
      if (!trigger) return;
      open(Number(trigger.dataset.artworkIndex ?? 0), trigger);
    });

    dialog.querySelector('[data-close]')?.addEventListener('click', close);
    dialog.querySelector('[data-prev]')?.addEventListener('click', () => go(-1));
    dialog.querySelector('[data-next]')?.addEventListener('click', () => go(1));

    dialog.addEventListener('click', (event) => {
      const target = event.target as HTMLElement;
      if (target === dialog || target.hasAttribute('data-stage')) close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') {
        event.preventDefault();
        go(1);
      } else if (event.key === 'ArrowLeft') {
        event.preventDefault();
        go(-1);
      }
    });

    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      lastTrigger?.focus({ preventScroll: true });
    });

    stage?.addEventListener('pointerdown', (event) => {
      if ((event.target as HTMLElement).closest('button')) return;
      pointerStart = { x: event.clientX, y: event.clientY };
    });

    stage?.addEventListener('pointerup', (event) => {
      if (!pointerStart) return;
      const dx = event.clientX - pointerStart.x;
      const dy = event.clientY - pointerStart.y;
      pointerStart = null;
      if (Math.abs(dx) > 48 && Math.abs(dx) > Math.abs(dy)) {
        go(dx < 0 ? 1 : -1);
      }
    });

    stage?.addEventListener('pointercancel', () => {
      pointerStart = null;
    });
  }

  function setup() {
    resizeObservers.forEach((observer) => observer.disconnect());
    resizeObservers = [];
    document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(setupGallery);
  }

  setup();
  document.addEventListener('astro:page-load', setup);
</script>
