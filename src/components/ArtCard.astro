---
import { Image } from 'astro:assets';
import type { Artwork } from '../lib/art';

interface Props {
  artwork: Artwork;
  index: number;
  priority?: boolean;
  showCollection?: boolean;
}

const { artwork, index, priority = false, showCollection = false } = Astro.props;
const { image, title, year } = artwork;
const isSvg = image.format === 'svg';
const delay = Math.min(index, 6) * 55;
---

<figure class="reveal group" data-artwork-card style={`--reveal-delay: ${delay}ms`}>
  <button
    type="button"
    class="block w-full cursor-zoom-in text-left"
    data-artwork-index={index}
    aria-label={`View ${title}${year ? `, ${year}` : ''} at full size`}
  >
    <span class="artframe">
      {
        isSvg ? (
          <img
            src={image.src}
            width={image.width}
            height={image.height}
            alt={artwork.alt}
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
            class="h-auto w-full transition-transform duration-[1.4s] ease-soft group-hover:scale-[1.018]"
          />
        ) : (
          <Image
            src={image}
            alt={artwork.alt}
            widths={[400, 640, 900, 1200, 1600]}
            sizes="(min-width: 1024px) 30vw, (min-width: 640px) 46vw, 94vw"
            format="webp"
            quality={88}
            loading={priority ? 'eager' : 'lazy'}
            decoding="async"
            class="h-auto w-full transition-transform duration-[1.4s] ease-soft group-hover:scale-[1.018]"
          />
        )
      }
    </span>
  </button>

  <figcaption class="mt-3 flex items-baseline justify-between gap-4 border-t border-line/80 pt-2.5">
    <span class="font-serif text-[1.05rem] leading-snug tracking-[-0.01em]">{title}</span>
    <span class="shrink-0 text-[0.7rem] uppercase tracking-[0.14em] text-ink-faint">
      {showCollection ? artwork.collectionName : year ?? ''}
    </span>
  </figcaption>
</figure>
