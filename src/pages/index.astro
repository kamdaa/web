---
import Base from '../layouts/Base.astro';
import ArtGrid from '../components/ArtGrid.astro';
import Ornaments from '../components/Ornaments.astro';
import { site } from '../config';
import { getRecentArtworks } from '../lib/art';
import { url } from '../lib/url';

const recent = getRecentArtworks(6);
---

<Base>
  <section class="relative overflow-hidden">
    <Ornaments />

    <div class="container-page relative z-10 py-20 text-center md:py-28">
      <h1
        class="font-serif text-[clamp(2.7rem,6vw,4.4rem)] leading-[0.95] tracking-[-0.04em] reveal"
      >
        <span class="block">Kamda</span>
        <span
          class="block italic text-sage-deep"
          style="font-variation-settings: 'SOFT' 70, 'WONK' 1;"
        >
          Kachroo
        </span>
      </h1>

      <p
        class="mx-auto mt-6 max-w-sm text-[1rem] leading-relaxed text-ink-soft reveal md:text-[1.1rem]"
        style="--reveal-delay: 90ms"
      >
        {site.tagline}
      </p>

      <div
        class="mt-9 flex justify-center reveal"
        style="--reveal-delay: 150ms"
      >
        <a class="arrow-link" href={url('/work')}>
          <span>View the work</span>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <section class="container-page mt-10 md:mt-14">
    <header class="reveal flex flex-wrap items-end justify-between gap-6 border-b border-line pb-5">
      <h2 class="text-[2rem] leading-none tracking-[-0.03em] md:text-[2.6rem]">Recent work</h2>
      <a class="arrow-link" href={url('/work')}>
        <span>All collections</span>
        <span class="arrow" aria-hidden="true">→</span>
      </a>
    </header>

    <div class="mt-10">
      <ArtGrid artworks={recent} showCollection />
    </div>
  </section>
</Base>
