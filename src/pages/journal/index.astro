---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/format';
import { url } from '../../lib/url';

const posts = (await getCollection('journal', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Base
  title="Journal"
  description="Occasional notes on painting, colour, and the things that turn into work."
>
  <section class="container-page pt-14 md:pt-20">
    <div class="grid gap-8 border-b border-line pb-10 md:grid-cols-2 md:items-end md:pb-12">
      <div>
        <p class="eyebrow reveal">Journal</p>
        <h1 class="mt-5 text-heading reveal" style="--reveal-delay: 70ms">Notes, slowly.</h1>
      </div>
      <p
        class="max-w-md text-[1.02rem] leading-relaxed text-ink-soft reveal md:justify-self-end"
        style="--reveal-delay: 130ms"
      >
        Occasional writing on painting, colour, and the things that turn into work. Nothing on a
        schedule.
      </p>
    </div>
  </section>

  <section class="container-page">
    {
      posts.map((post) => (
        <a
          href={url(`/journal/${post.id}`)}
          class="group grid gap-3 border-b border-line py-8 md:grid-cols-12 md:items-baseline md:gap-6 md:py-10"
        >
          <p class="eyebrow md:col-span-2">{formatDate(post.data.date)}</p>

          <div class="md:col-span-7">
            <h2 class="font-serif text-[1.55rem] leading-[1.15] tracking-[-0.02em] transition-colors group-hover:text-sage-deep md:text-[1.9rem]">
              {post.data.title}
            </h2>
            <p class="mt-3 max-w-xl text-[0.95rem] leading-relaxed text-ink-soft">
              {post.data.excerpt}
            </p>
          </div>

          <span class="arrow-link md:col-span-3 md:justify-self-end">
            <span>Read</span>
            <span class="arrow" aria-hidden="true">→</span>
          </span>
        </a>
      ))
    }

    {
      posts.length === 0 && (
        <p class="py-16 text-center text-ink-soft">
          Nothing here yet. Add a Markdown file to <code>src/content/journal/</code>.
        </p>
      )
    }
  </section>
</Base>
